{
  "name": "scene-master",
  "version": "0.1.0",
  "private": true,
  "description": "场景通 — 场景落地分析智能体",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dsh:start": "bash scripts/start.sh",
    "dsh:stop": "bash scripts/stop.sh",
    "dsh:status": "curl -s -o /dev/null -w 'HTTP %{http_code}\\n' --max-time 3 http://127.0.0.1:3081/ || echo '未运行'",
    "dsh:logs": "tail -f .dsh/dsh-web.log",
    "typecheck": "pnpm run typecheck:packages && tsc -b apps/server apps/web",
    "build": "pnpm -r --if-present run build",
    "lint": "echo 'lint placeholder — TODO: 集成 eslint'",
    "test": "vitest run",
    "start": "node apps/server/dist/index.js",
    "verify:m0": "bash scripts/verify-m0.sh",
    "verify:m1": "bash scripts/verify-m1.sh",
    "verify:m2": "bash scripts/verify-m2.sh",
    "verify:m3": "bash scripts/verify-m3.sh",
    "verify:m4": "bash scripts/verify-m4.sh",
    "release": "bash scripts/build-release.sh",
    "test:e2e": "pnpm --filter @scene/web exec vite build && playwright test",
    "verify:m5": "bash scripts/verify-m5.sh",
    "gen:docs": "pnpm --filter @scene/contract build && node scripts/gen-table-docs.mjs",
    "check:docs": "pnpm --filter @scene/contract build && node scripts/gen-table-docs.mjs --check",
    "typecheck:packages": "tsc --noEmit -p tsconfig.json"
  }
}
