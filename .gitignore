# 依赖
node_modules/

# 运行时数据库
data/

# release 打包产物
release/

# DSH 源码（git clone，有自己的 .git，不入库；构建见 AGENTS.md）
vendor/

# DSH 实例数据（运行时生成/迁移，不入库；配置与凭据共享方式见 AGENTS.md 第二章）
.dsh/

# 系统文件
.DS_Store

# Playwright E2E 产物
test-results/
playwright-report/

# 交付物导出目录
exports/

# tsc 误编译落盘（源码目录只留 .ts；根 vitest.config 以 .ts 为准）
/packages/*/src/**/*.js
/vitest.config.js

# 构建产物不入库（源码库只留源码；构建命令见 package.json / scripts/build-release.sh）
# 理由：dist 与 tsbuildinfo 每次构建都变，入库会产生噪音 diff，且与 server/infra/domain 的既有做法不一致
dist/
*.tsbuildinfo

# 本地包管理器存储（36MB，pnpm 本地 store）
.pnpm-store/

# 百度云同步产生的临时文件（不是项目产物）
.baiduyun.uploading.cfg
**/.baiduyun.uploading.cfg

# 模型原始输出留证（解析失败必存；排查用，不进版本库）
data/raw-output/

# 桌面版：Electron 运行时装配产物（pnpm deploy + 原生模块重建，属生成物）
apps/desktop/runtime/
# 桌面版：electron-builder 从 build/icon.png 生成的平台图标
apps/desktop/build/icon.icns
apps/desktop/build/icon.ico
apps/desktop/build/icons/
# 桌面版：electron-builder 输出的安装包/未压缩应用（100MB+，分发走 Release/网盘）
apps/desktop/release/
